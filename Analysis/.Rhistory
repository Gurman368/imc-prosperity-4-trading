View(prices_round_0_day_.1)
# Load required libraries
library(tidyverse)
library(patchwork) # For dashboard-like layout
# 1. LOAD DATA
# Note: The sources show these files use semicolons (;) as separators
p1 <- read.csv("~/GitHub/Imc_prosperity4_ISI_BSDS/Analysis/tutorial round/prices_round_0_day_-1.csv", header=FALSE, sep=";")
p2 <- read.csv("~/GitHub/Imc_prosperity4_ISI_BSDS/Analysis/tutorial round/prices_round_0_day_-2.csv", header=FALSE, sep=";")
t1 <- read.csv("~/GitHub/Imc_prosperity4_ISI_BSDS/Analysis/tutorial round/trades_round_0_day_-1.csv", header=FALSE, sep=";")
t2 <- read.csv("~/GitHub/Imc_prosperity4_ISI_BSDS/Analysis/tutorial round/trades_round_0_day_-2.csv", header=FALSE, sep=";")
# Combine datasets and add labels
prices <- bind_rows(p1, p2)
trades <- bind_rows(
t1 %>% mutate(day = -1),
t2 %>% mutate(day = -2)
) %>% rename(product = symbol)
# 2. STATISTICAL SUMMARY DASHBOARD
summary_stats <- prices %>%
group_by(product, day) %>%
summarise(
Avg_Mid_Price = mean(mid_price, na.rm = TRUE),
Volatility_SD = sd(mid_price, na.rm = TRUE),
Avg_Spread = mean(ask_price_1 - bid_price_1, na.rm = TRUE),
Max_Price = max(mid_price, na.rm = TRUE),
Min_Price = min(mid_price, na.rm = TRUE),
.groups = 'drop'
)
# Combine datasets and add labels
prices <- bind_rows(p1, p2)
trades <- bind_rows(
t1 %>% mutate(day = -1),
t2 %>% mutate(day = -2)
) %>% rename(product = symbol)
# 1. LOAD DATA
# Note: The sources show these files use semicolons (;) as separators
p1 <- read.csv("~/GitHub/Imc_prosperity4_ISI_BSDS/Analysis/tutorial round/prices_round_0_day_-1.csv", header=TRUE, sep=";")
p2 <- read.csv("~/GitHub/Imc_prosperity4_ISI_BSDS/Analysis/tutorial round/prices_round_0_day_-2.csv", header=TRUE, sep=";")
t1 <- read.csv("~/GitHub/Imc_prosperity4_ISI_BSDS/Analysis/tutorial round/trades_round_0_day_-1.csv", header=TRUE, sep=";")
t2 <- read.csv("~/GitHub/Imc_prosperity4_ISI_BSDS/Analysis/tutorial round/trades_round_0_day_-2.csv", header=TRUE, sep=";")
# Combine datasets and add labels
prices <- bind_rows(p1, p2)
trades <- bind_rows(
t1 %>% mutate(day = -1),
t2 %>% mutate(day = -2)
) %>% rename(product = symbol)
# 2. STATISTICAL SUMMARY DASHBOARD
summary_stats <- prices %>%
group_by(product, day) %>%
summarise(
Avg_Mid_Price = mean(mid_price, na.rm = TRUE),
Volatility_SD = sd(mid_price, na.rm = TRUE),
Avg_Spread = mean(ask_price_1 - bid_price_1, na.rm = TRUE),
Max_Price = max(mid_price, na.rm = TRUE),
Min_Price = min(mid_price, na.rm = TRUE),
.groups = 'drop'
)
print("--- Market Price Statistics ---")
print(summary_stats)
# Plot A: Mid Price Trends across both days
plot_prices <- ggplot(prices, aes(x = timestamp, y = mid_price, color = as.factor(day))) +
geom_line() +
facet_wrap(~product, scales = "free_y") +
labs(title = "Price Trends: EMERALDS (Stable) vs TOMATOES (Fluctuating)",
subtitle = "Comparing Mid-Prices for Day -1 and Day -2",
x = "Timestamp", y = "Mid Price", color = "Day") +
theme_minimal()
# Plot B: Trade Volume Intensity
plot_trades <- ggplot(trades, aes(x = timestamp, y = quantity, fill = as.factor(day))) +
geom_bar(stat = "identity", alpha = 0.6) +
facet_wrap(~product) +
labs(title = "Trade Volume Distribution",
x = "Timestamp", y = "Quantity Traded", fill = "Day") +
theme_minimal()
# Plot C: Order Book Depth (Liquidity Analysis)
prices_long <- prices %>%
mutate(bid_depth = bid_volume_1 + ifelse(is.na(bid_volume_2), 0, bid_volume_2),
ask_depth = ask_volume_1 + ifelse(is.na(ask_volume_2), 0, ask_volume_2))
plot_liquidity <- ggplot(prices_long, aes(x = product)) +
geom_boxplot(aes(y = bid_depth, fill = "Bid Depth"), alpha = 0.5) +
geom_boxplot(aes(y = ask_depth, fill = "Ask Depth"), alpha = 0.5) +
labs(title = "Order Book Liquidity Depth", y = "Total Volume at L1/L2", fill = "Side") +
theme_minimal()
# Combine into a dashboard
(plot_prices) / (plot_trades | plot_liquidity)
